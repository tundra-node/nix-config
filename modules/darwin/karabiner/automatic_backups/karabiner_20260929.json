{
    "global": { "show_in_menu_bar": false },
    "machine_specific": { "krbn-empty-machine-identifier": { "enable_multitouch_extension": true } },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock -> Left Command (SUPER equivalent), tap -> Escape",
                        "manipulators": [
                            {
                                "description": "Caps hold -> Left Command, tap -> Escape",
                                "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
                                "to": [{ "key_code": "left_command" }],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Left Command + Left Control = Hyper (for AeroSpace mod)",
                        "manipulators": [
                            {
                                "description": "Left Command + Left Control -> Hyper (cmd+ctrl+opt+shift)",
                                "from": {
                                    "key_code": "left_command",
                                    "modifiers": { "mandatory": ["left_control"], "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_command", "modifiers": ["left_control", "left_option", "left_shift"] }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": { "is_keyboard": true, "product_id": 50495, "vendor_id": 1133 },
                    "ignore_vendor_events": true
                }
            ],
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
