# Copy to .env (gitignored) and fill from Mullvad → WireGuard config
# https://mullvad.net/en/account/wireguard-config
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=REPLACE_WITH_MULLVAD_PRIVATE_KEY
WIREGUARD_ADDRESSES=10.x.y.z/32
SERVER_CITIES=Stockholm
# Optional: pick specific city/country
# SERVER_COUNTRIES=Sweden
# FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24  # allow LAN access through killswitch
DOT=off
