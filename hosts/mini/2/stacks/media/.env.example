# Install as /var/lib/secrets/stacks/media.env with mode 0600; do not commit it.
# Fill the Mullvad values from the WireGuard config.
# https://mullvad.net/en/account/wireguard-config
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=REPLACE_WITH_MULLVAD_PRIVATE_KEY
WIREGUARD_ADDRESSES=10.x.y.z/32
SERVER_CITIES=Stockholm
# Optional: pick specific city/country
# SERVER_COUNTRIES=Sweden
# FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24  # allow LAN access through killswitch
DOT=off
# Required before the Immich stack starts. Generate a strong random value.
IMMICH_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Optional Navidrome Last.fm values:
# ND_LASTFM_APIKEY=
# ND_LASTFM_SECRET=
