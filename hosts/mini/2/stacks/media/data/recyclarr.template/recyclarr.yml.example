# recyclarr - syncs TRaSH Guides quality definitions to Sonarr/Radarr
# copy to /etc/stacks/media/data/recyclarr/recyclarr.yml on mini2 and set API keys via .env:
# SONARR_API_KEY=xxx
# RADARR_API_KEY=xxx
# docs: https://recyclarr.dev/wiki/quick-start/

sonarr:
  sonarr:
    base_url: http://sonarr:8989
    api_key: !env_var SONARR_API_KEY
    quality_definition:
      type: series

radarr:
  radarr:
    base_url: http://radarr:7878
    api_key: !env_var RADARR_API_KEY
    quality_definition:
      type: movie
